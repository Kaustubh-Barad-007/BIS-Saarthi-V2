<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 200" width="200" height="200">
  <!-- Outer circle - dark blue border -->
  <circle cx="100" cy="100" r="95" fill="#003580" stroke="#C8A951" stroke-width="4"/>
  
  <!-- Inner white circle -->
  <circle cx="100" cy="100" r="82" fill="white"/>
  
  <!-- Ashoka Chakra - 24 spokes wheel -->
  <g transform="translate(100,100)">
    <!-- Wheel outer ring -->
    <circle r="38" fill="none" stroke="#000080" stroke-width="4"/>
    <!-- Wheel hub -->
    <circle r="7" fill="#000080"/>
    <!-- 24 spokes -->
    <g stroke="#000080" stroke-width="1.5">
      <line x1="0" y1="-7" x2="0" y2="-38"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(15)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(30)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(45)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(60)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(75)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(90)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(105)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(120)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(135)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(150)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(165)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(180)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(195)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(210)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(225)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(240)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(255)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(270)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(285)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(300)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(315)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(330)"/>
      <line x1="0" y1="-7" x2="0" y2="-38" transform="rotate(345)"/>
    </g>
  </g>
  
  <!-- BIS text top arc -->
  <path id="topArc" fill="none" d="M 35,100 A 65,65 0 0,1 165,100"/>
  <text fill="#003580" font-size="14" font-weight="bold" font-family="Arial,sans-serif" letter-spacing="2">
    <textPath href="#topArc" startOffset="18%">BUREAU OF INDIAN STANDARDS</textPath>
  </text>
  
  <!-- Bottom arc text -->
  <path id="bottomArc" fill="none" d="M 38,110 A 62,62 0 0,0 162,110"/>
  <text fill="#003580" font-size="13" font-weight="bold" font-family="Arial,sans-serif" letter-spacing="1">
    <textPath href="#bottomArc" startOffset="22%">भारतीय मानक ब्यूरो</textPath>
  </text>

  <!-- BIS large center text -->
  <text x="100" y="107" text-anchor="middle" fill="#003580" font-size="20" font-weight="900" font-family="Arial Black,Arial,sans-serif" letter-spacing="3">BIS</text>
  
  <!-- Gold bottom band -->
  <rect x="5" y="162" width="190" height="28" rx="4" fill="#003580"/>
  <text x="100" y="181" text-anchor="middle" fill="#C8A951" font-size="10" font-weight="bold" font-family="Arial,sans-serif" letter-spacing="1.5">MANAK BHAVAN • NEW DELHI</text>
</svg>
